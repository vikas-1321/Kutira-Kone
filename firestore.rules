rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 3. Primitive Definition
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email']) &&
               data.uid == request.auth.uid &&
               data.email is string &&
               (!('displayName' in data) || data.displayName is string) &&
               (!('photoURL' in data) || data.photoURL is string);
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'location']);
    }

    // --- Scraps Collection ---
    match /scraps/{scrapId} {
      function isValidScrap(data) {
        return data.keys().hasAll(['imageUrl', 'materialType', 'approxSize', 'location', 'donorId', 'status', 'createdAt']) &&
               data.imageUrl is string &&
               data.materialType in ['Silk', 'Cotton', 'Wool', 'Synthetic'] &&
               data.approxSize is string &&
               data.donorId == request.auth.uid &&
               data.status in ['Available', 'Swapped'] &&
               data.createdAt == request.time;
      }

      allow read: if true; // Publicly viewable for browsing
      allow create: if isSignedIn() && isValidScrap(incoming()) && isValidId(scrapId);
      allow update: if isSignedIn() && (
        // Owner can update any valid field except immutables
        (isOwner(existing().donorId) && isValidScrap(incoming()) && 
         incoming().donorId == existing().donorId && incoming().createdAt == existing().createdAt) ||
        // Anyone can update status if it's a swap action (simulated)
        (incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'Swapped')
      );
      allow delete: if isSignedIn() && isOwner(existing().donorId);
    }

    // --- Trade Requests ---
    match /tradeRequests/{requestId} {
      function isValidTrade(data) {
        return data.keys().hasAll(['scrapId', 'requesterId', 'ownerId', 'status', 'createdAt']) &&
               data.requesterId == request.auth.uid &&
               data.status == 'Pending' &&
               data.createdAt == request.time;
      }

      allow read: if isSignedIn() && (isOwner(resource.data.requesterId) || isOwner(resource.data.ownerId));
      allow create: if isSignedIn() && isValidTrade(incoming());
      allow update: if isSignedIn() && (
        // Only owner can accept/reject
        isOwner(existing().ownerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status in ['Accepted', 'Rejected']
      );
    }
  }
}
