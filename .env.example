# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform.
# Get one at: https://console.cloud.google.com/google/maps-apis/start
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"

# CLOUDINARY CONFIG:
# Create an "Unsigned Upload Preset" in Cloudinary Settings -> Upload
VITE_CLOUDINARY_CLOUD_NAME="deomtojnu"
VITE_CLOUDINARY_UPLOAD_PRESET="KutiraKone"
